[Unit]
Description=Cloudflare quick tunnel for G4C preview
After=network.target g4c-site.service
Requires=g4c-site.service

[Service]
ExecStart=/home/ubuntu/vnc-browser/bin/cloudflared tunnel --no-autoupdate --url http://127.0.0.1:8090
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
